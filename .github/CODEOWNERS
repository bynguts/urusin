# Pemilik kode. Pola terakhir yang cocok menang. Area bersama ditinjau kedua anggota.
# @rafilajhh: seluruh UI/UX (halaman, layout, komponen web)
# @bynguts: sisanya (server/API web, harness, llm, rag, fixtures, adapter, registry, data, deploy)

*                                  @bynguts @rafilajhh

/apps/web/                         @bynguts
/packages/llm/                     @bynguts
/packages/harness/                 @bynguts
/deploy/                           @bynguts

/apps/fixtures/                    @bynguts
/packages/registry/                @bynguts
/packages/adapters/                @bynguts

/packages/rag/                     @bynguts
/data/                             @bynguts

# UI/UX milik @rafilajhh (di bawah /apps/web/ yang lain tetap @bynguts). Pola setelahnya menang.
/apps/web/src/routes/**/+page.svelte    @rafilajhh
/apps/web/src/routes/**/+layout.svelte  @rafilajhh
/apps/web/src/routes/**/+error.svelte   @rafilajhh
/apps/web/src/lib/components/           @rafilajhh

# Sisi server web tetap @bynguts walau berada di dalam folder routes (menang atas pola UI di atas)
/apps/web/src/routes/api/               @bynguts
/apps/web/src/routes/**/*.server.ts     @bynguts

# Dokumen dan konfigurasi bersama
/packages/core/                    @bynguts @rafilajhh
/docs/                             @bynguts @rafilajhh
/.github/                          @bynguts @rafilajhh
/scripts/                          @bynguts @rafilajhh
