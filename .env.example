# =====================================================================
# Contoh konfigurasi Urusin. Salin ke `.env` lalu isi nilainya.
# JANGAN pernah meng-commit `.env` berisi nilai asli.
# Semua nilai di bawah hanya placeholder.
# =====================================================================

# --- Domain & origin publik ---
# Domain utama aplikasi (dipakai Caddy untuk TLS otomatis)
DOMAIN=urusin.example.com
# Origin publik aplikasi web (dipakai ekstensi untuk externally_connectable)
URUSIN_PUBLIC_ORIGIN=https://urusin.example.com

# --- Gateway LLM (OpenAI-compatible, Chat Completions) ---
# Base URL penyedia yang kompatibel dengan API OpenAI
LLM_BASE_URL=https://llm.example.com/v1
# Produksi (VPS, web memakai network_mode host): proxy LLM di host lewat loopback, bukan IP publik/tailscale:
#   LLM_BASE_URL=http://127.0.0.1:20128/v1
# (iptables host men-DROP port proxy dari jaringan bridge Docker; loopback diizinkan.)
# Kunci API penyedia LLM
LLM_API_KEY=ganti-dengan-kunci-api
# Model untuk agen utama (tool calling)
LLM_AGENT_MODEL=nama-model-agen
# Model untuk vision (pemeriksaan dokumen/foto)
LLM_VISION_MODEL=nama-model-vision
# Model untuk transkripsi suara
LLM_TRANSCRIBE_MODEL=nama-model-transkripsi
# Base URL terpisah untuk transkripsi (opsional, kosongkan bila sama)
LLM_TRANSCRIBE_BASE_URL=
# --- Embedding dan rerank RAG (penyedia sendiri; opsional, kosong = hanya BM25 + stem + glosarium) ---
# Hasil eval (packages/rag/README.md): jina-embeddings-v5-omni-small tanpa transformasi, reranker jina-reranker-v3.
# Base URL embedding (kosong = LLM_BASE_URL; kunci LLM_API_KEY hanya dipakai bila base URL kosong)
LLM_EMBED_BASE_URL=https://embed.example.com/v1
LLM_EMBED_API_KEY=ganti-dengan-kunci-embedding
LLM_EMBED_MODEL=nama-model-embedding
# Nilai field "task" penyedia (mis. Jina): kueri vs dokumen
LLM_EMBED_TASK_QUERY=retrieval.query
LLM_EMBED_TASK_PASSAGE=retrieval.passage
# Rerank gaya /v1/rerank
RERANK_BASE_URL=https://rerank.example.com/v1
RERANK_API_KEY=ganti-dengan-kunci-rerank
RERANK_MODEL=nama-model-rerank
# Harga USD per 1 juta token (meter biaya eval; 0 = tidak dihitung)
LLM_EMBED_PRICE_PER_MTOK=0
RERANK_PRICE_PER_MTOK=0
# Ambang abstain: cakupan leksikal (0..1) dan lantai skor rerank (skala tergantung model; 0.05 untuk jina-reranker-v3)
RAG_ABSTAIN_MIN_COVERAGE=0.1
RAG_ABSTAIN_MIN_RERANK_SCORE=0.05
# Batas waktu request (ms) dan jumlah retry
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- Harga untuk meter biaya (USD) ---
# Harga per 1 juta token input
LLM_PRICE_INPUT_PER_MTOK=0
# Harga per 1 juta token output
LLM_PRICE_OUTPUT_PER_MTOK=0
# Harga per menit audio transkripsi
LLM_PRICE_AUDIO_PER_MIN=0

# --- Batas laju penyedia ---
# Request per menit
LLM_RPM=60
# Token per menit
LLM_TPM=100000

# --- Override hasil capability probe (1 = paksa nonaktif) ---
LLM_FORCE_NO_TOOLS=
LLM_FORCE_NO_PARALLEL_TOOLS=
LLM_FORCE_NO_JSON_SCHEMA=
LLM_FORCE_NO_VISION=
LLM_FORCE_NO_STREAM_TOOLS=
LLM_FORCE_NO_TRANSCRIPTION=
LLM_FORCE_NO_EMBEDDINGS=
# Snapshot kapabilitas yang di-pin saat freeze (JSON, opsional)
LLM_CAPS_PIN=

# --- Web Push (VAPID) ---
# Buat dengan `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=ganti-dengan-kunci-publik-vapid
VAPID_PRIVATE_KEY=ganti-dengan-kunci-privat-vapid
VAPID_SUBJECT=mailto:noreply@example.com

# --- Fitur opsional (1 = aktif, 0 = mati) ---
URUSIN_FEATURE_VOICE=0
URUSIN_FEATURE_REMINDERS=0

# --- Basis data & sesi ---
# Lokasi SQLite (libSQL)
DATABASE_URL=file:./data/urusin.db
# Rahasia sesi, minimal 32 karakter acak
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- Cloudflare Turnstile (anti-bot) ---
# Gunakan test key Cloudflare untuk lokal/CI
TURNSTILE_SITE_KEY=ganti-dengan-site-key
TURNSTILE_SECRET_KEY=ganti-dengan-secret-key

# --- Kuota & pengaman biaya ---
# Batas biaya harian (USD)
URUSIN_DAILY_USD_CAP=5
# Batas biaya harian (IDR). WAJIB > 0 di mode LLM: server menolak boot tanpa batas yang berhingga.
URUSIN_DAILY_IDR_CAP=50000
# Kunci HMAC pemetaan placeholder PII, base64 dari minimal 32 byte acak (openssl rand -base64 32).
# WAJIB di mode LLM dan harus sama di semua instance (blue/green) agar token placeholder stabil.
URUSIN_PII_KEY=ganti-dengan-base64-32-byte-acak
# Batas laju: urusan baru per jam (per IP / per sesi), turn per menit (per IP / per sesi)
URUSIN_LIMIT_BUAT_IP_PER_JAM=20
URUSIN_LIMIT_BUAT_SESI_PER_JAM=10
URUSIN_LIMIT_TURN_IP_PER_MENIT=30
URUSIN_LIMIT_TURN_SESI_PER_MENIT=20
# Batas token per sesi
URUSIN_SESSION_TOKEN_CAP=200000
# Batas giliran percakapan per sesi
URUSIN_SESSION_TURN_CAP=60
# Batas sesi baru per IP per hari
URUSIN_IP_SESSIONS_PER_DAY=20
# Webhook untuk alert (kosongkan bila tidak dipakai)
URUSIN_ALERT_WEBHOOK=
# 1 = matikan seluruh panggilan LLM (mode darurat)
URUSIN_LLM_DISABLED=0

# --- Ekstensi peramban ---
# ID ekstensi yang dipin (dipakai web app untuk pairing). Diturunkan dari apps/extension/manifest-key.pub
# (pnpm --filter @urusin/extension key:id); dijaga konsisten oleh tes.
PUBLIC_EXTENSION_ID=flifbmblngmmnffpjbfmhmflkdfgnjhf
# Origin fixture yang diizinkan ekstensi saat build (dipisah koma; hanya aktif di Mode Uji)
URUSIN_FIXTURES_ORIGINS=http://localhost:4320,http://127.0.0.1:4320

# --- Fixture (apps/fixtures) ---
# Profil: public (jinak, aman deploy) atau local (laptop/CI)
FIXTURES_PROFILE=public
FIXTURES_PORT=4320
# Origin publik persis untuk cek Origin POST (kosongkan untuk dev lokal)
FIXTURES_PUBLIC_ORIGIN=

# --- Build ---
# SHA commit yang di-deploy (diisi otomatis oleh CI)
GIT_SHA=

# --- Deploy (VPS) ---
# Image web berdasarkan digest. Ditulis otomatis oleh deploy/deploy.sh ke deploy/.env.images;
# isi manual hanya untuk uji compose.
# WEB_IMAGE=ghcr.io/bynguts/urusin-web@sha256:ganti-dengan-digest
# Image fixtures publik (opsional; hanya dipakai bila COMPOSE_PROFILES=fixtures)
# FIXTURES_IMAGE=ghcr.io/bynguts/urusin-fixtures@sha256:...

# --- Produksi (VPS) ---
# Kunci asli HANYA di deploy/.env (chmod 600). URUSIN_PII_KEY dan URUSIN_DAILY_IDR_CAP wajib di mode llm
# (bagian "Kuota & pengaman biaya"). Jina (embedding/rerank): LLM_EMBED_* dan RERANK_* di atas; host
# api.jina.ai diizinkan egress server. ADDRESS_HEADER=X-Forwarded-For dan XFF_DEPTH=1 diisi compose.prod.yml.
