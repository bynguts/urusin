{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/output/**", ".output/**"],
      "env": ["GIT_SHA"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "budget": {
      "dependsOn": ["build"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["build", "^build"],
      "cache": false
    }
  }
}
