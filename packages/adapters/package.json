{
  "name": "@urusin/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Program adapter situs resmi (Step DSL) untuk Browser Pendamping: alur, probe sesi, dan bukti",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@urusin/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@urusin/executor": "workspace:*",
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
