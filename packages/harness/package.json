{
  "name": "@urusin/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Harness agen Urusin: loop, state machine CAS, policy gate, audit, grounding, spotlighting, eval",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsc -p tsconfig.build.json && node dist/eval/cli.js",
    "record:fixtures": "tsc -p tsconfig.build.json && node dist/eval/record.js",
    "migrate": "tsc -p tsconfig.build.json && node dist/migrate-cli.js",
    "bench:latensi": "tsc -p tsconfig.build.json && node dist/eval/latensi.js"
  },
  "dependencies": {
    "@urusin/adapters": "workspace:*",
    "@urusin/contracts": "workspace:*",
    "@urusin/core": "workspace:*",
    "@urusin/llm": "workspace:*",
    "@urusin/rag": "workspace:*",
    "@urusin/registry": "workspace:*",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "vitest": "5.1.0"
  }
}
