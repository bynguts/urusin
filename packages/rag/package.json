{
  "name": "@urusin/rag",
  "version": "0.0.0",
  "private": true,
  "description": "Basis pengetahuan RAG hibrida (FTS5 BM25 + RRF) dengan kutipan bersumber untuk Urusin",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "rag:ingest": "tsc -p tsconfig.build.json && node dist/ingest/cli.js"
  },
  "dependencies": {
    "@urusin/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@urusin/llm": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "vitest": "5.1.0"
  }
}
