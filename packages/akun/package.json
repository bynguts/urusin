{
  "name": "@urusin/akun",
  "version": "0.0.0",
  "private": true,
  "description": "Akun warga Urusin: email + sandi (argon2id), Google OIDC, sesi server, token email, vault terenkripsi per pemilik",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "kek:rotate": "tsc -p tsconfig.build.json && node dist/kek-rotate-cli.js"
  },
  "dependencies": {
    "@urusin/harness": "workspace:*",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
