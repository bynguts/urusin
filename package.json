{
  "name": "urusin",
  "version": "0.0.0",
  "private": true,
  "description": "Urusin: agen AI yang ikut mengurus layanan publik bersama warga",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:scripts",
    "test:scripts": "node --test scripts/tests/",
    "audit:history": "node scripts/audit-history.mjs",
    "pii:scan": "node scripts/pii-scan.mjs --all",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
