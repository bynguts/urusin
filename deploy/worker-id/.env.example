# Salin lewat `bash deploy/worker-id/worker.sh init` (membuat .env, chmod 600, mengisi token acak tanpa
# menampilkannya). .env di folder ini diabaikan git; JANGAN di-commit.

# Domain web Urusin (origin WS warga, replika Mode Uji fixtures.$DOMAIN)
DOMAIN=urusinai.web.id
# Id worker di PENDAMPING_WORKERS web dan di jalur Caddy /pendamping/w/<id>/ws (huruf kecil, angka, minus)
WORKER_ID=laptop-a
# IP Tailscale laptop ini (`tailscale ip -4`). WAJIB 100.64.0.0/10; port edge diikat HANYA ke IP ini.
WORKER_TAILSCALE_IP=
WORKER_PORT=4330
# Rahasia HMAC web -> worker ini (>= 32 karakter); juga dipasang sebagai `token` worker ini di web.
WORKER_TOKEN=
# Rahasia HMAC pendamping -> edge (>= 32 karakter), BEDA dari WORKER_TOKEN; tidak pernah keluar laptop.
WORKER_EDGE_TOKEN=
# Sesi Chromium bersamaan di laptop ini
PENDAMPING_MAX_SESSIONS=1
# Image: bawaan dibangun lokal (`worker.sh build`). Atau digest rilis yang SAMA dengan produksi, mis.
# ghcr.io/bynguts/urusin-pendamping@sha256:... (butuh `docker login ghcr.io` dengan PAT read:packages).
# PENDAMPING_IMAGE=
# Opsional, uji kemudi manual (/debug, >= 32 karakter). Kosongkan setelah uji: /debug ikut terjangkau tailnet.
PENDAMPING_DEBUG_TOKEN=
