#!/usr/bin/env bash
# shellcheck disable=SC2016  # skrip kontainer sengaja dikutip tunggal: diekspansi DI DALAM kontainer
# Satu-satunya pintu Docker untuk runner self-hosted `urusin-ci` (lihat deploy/ci-runner/README.md).
# Dipanggil lewat sudoers sempit (`sudo -n /opt/urusin-ci/bin/ci-docker <sub> ...`) supaya user runner TIDAK
# perlu grup docker (grup docker = root di host). Setiap subperintah memakai flag Docker yang tetap:
# tidak ada --privileged, tidak ada mount host selain workspace runner, tidak ada --network host,
# tidak ada --allow security.insecure, CPU/memori/pids dibatasi. Argumen divalidasi ketat.
#
#   ci-docker pw <e2e|perf> <workspace> <sha40>       Playwright resmi (versi = basis apps/pendamping/Dockerfile)
#   ci-docker build <web|fixtures|pendamping|embedding> <sha40> <workspace>   token GHCR di stdin; cetak "DIGEST: sha256:..."
#   ci-docker smoke <web|fixtures|pendamping|embedding> <sha256:digest> <workspace>  token GHCR di stdin
#   ci-docker simpan <web|fixtures|pendamping|embedding> <sha256:digest> <workspace> token GHCR di stdin; image native
#                                                      DISIMPAN di docker host + salinan provenance (deploy tanpa login)
#   ci-docker sbom <web|fixtures|pendamping|embedding> <sha256:digest>        token GHCR di stdin; SBOM JSON ke stdout
#   ci-docker alias <sha40> <rc*|v*>                   token GHCR di stdin; alias :<sha> -> :<tag> (tanpa build)
#   ci-docker builder-init | builder-gc | builder-rm  builder buildx `urusin-ci` (cache <= 1,5 GB)
#   ci-docker cleanup                                  hook job-completed: kontainer sisa urusin-ci-pw-*
#   ci-docker teardown                                 hapus builder + kontainer sisa urusin-ci-* (uninstall)
#
# Env URUSIN_CI_* hanya untuk uji (deploy/tests/ci-runner.test.sh) dan DIABAIKAN bila berjalan sebagai root,
# jadi sudoers yang salah konfigurasi (SETENV) pun tidak bisa membelokkan path/batas di produksi.
set -euo pipefail
umask 077

if [ "$(id -u)" = 0 ]; then
  unset URUSIN_CI_ROOT URUSIN_CI_DF_ROOT URUSIN_CI_DISK_MAX URUSIN_CI_USER URUSIN_CI_TEST_PATH URUSIN_CI_ARCH URUSIN_CI_BINFMT
fi
CI_ROOT="${URUSIN_CI_ROOT:-/opt/urusin-ci}"
# Salinan provenance image yang disimpan `simpan` (dibaca deploy.sh bila registry tidak bisa dijangkau tanpa login).
PROV_DIR="$CI_ROOT/provenance"
WORK_ROOT="$CI_ROOT/runner/_work"
BUILDER=urusin-ci
CACHE_MAX=1500mb # anggaran disk agent-vm (lihat README); sama dengan maxUsedSpace di buildkitd.toml
REPO_PREFIX=ghcr.io/bynguts/urusin
DISK_MAX="${URUSIN_CI_DISK_MAX:-88}"
CI_USER="${URUSIN_CI_USER:-urusin-ci}"
export BUILDX_CONFIG="$CI_ROOT/buildx"
export PATH="${URUSIN_CI_TEST_PATH:+$URUSIN_CI_TEST_PATH:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

die() { echo "ci-docker: $*" >&2; exit 1; }

disk_guard() {
  local pct
  pct="$(df --output=pcent "${URUSIN_CI_DF_ROOT:-/}" | tail -n1 | tr -dc '0-9')"
  [ -n "$pct" ] || die "tidak bisa membaca pemakaian disk"
  [ "$pct" -lt "$DISK_MAX" ] || die "disk ${pct}% >= ${DISK_MAX}%: job ditolak (lapor ke ops; jangan prune global)"
}

valid_name() { case "$1" in web | fixtures | pendamping | embedding) ;; *) die "nama image tidak dikenal: '$1'" ;; esac; }
valid_sha() { [[ "$1" =~ ^[0-9a-f]{40}$ ]] || die "SHA harus 40 hex: '$1'"; }
valid_digest() { [[ "$1" =~ ^sha256:[0-9a-f]{64}$ ]] || die "digest harus sha256:<64 hex>: '$1'"; }

# Workspace harus direktori nyata di bawah _work runner, milik user runner (bukan symlink ke luar).
valid_ws() {
  local ws real
  ws="$1"
  [ -d "$ws" ] || die "workspace tidak ada: '$ws'"
  real="$(cd "$ws" && pwd -P)"
  case "$real/" in "$WORK_ROOT"/*/*) ;; *) die "workspace di luar $WORK_ROOT: '$real'" ;; esac
  [ "$(stat -c %U "$real")" = "$CI_USER" ] || die "workspace bukan milik $CI_USER: '$real'"
  printf '%s' "$real"
}

# Image Playwright = basis runtime apps/pendamping/Dockerfile (dipin digest), jadi versi Chromium sama dengan
# @playwright/test di lockfile dan sama dengan image produksi.
pw_image() {
  local ref
  ref="$(sed -nE 's/^FROM (mcr\.microsoft\.com\/playwright:v[0-9.]+-noble@sha256:[0-9a-f]{64}) AS pwbasis$/\1/p' "$1/apps/pendamping/Dockerfile" | head -n1)"
  [ -n "$ref" ] || die "basis Playwright (FROM ... AS pwbasis, dipin digest) tidak ditemukan di apps/pendamping/Dockerfile"
  printf '%s' "$ref"
}

# DOCKER_CONFIG selalu temp milik root (bukan /root/.docker; unit memakai ProtectHome), dihapus saat keluar.
DOCKER_CONFIG="$(mktemp -d /tmp/urusin-ci-docker.XXXXXX)"
export DOCKER_CONFIG
# BUANG_REF: image smoke milik job ini, dibuang saat keluar (juga bila smoke gagal, melewati timeout, atau job
# dibatalkan). SMOKE_C: kontainer smoke yang sedang jalan, dihentikan dulu supaya image-nya bisa dibuang.
BUANG_REF=""
SMOKE_C=""
trap 'rm -rf "$DOCKER_CONFIG"; [ -z "$SMOKE_C" ] || docker rm -f "$SMOKE_C" >/dev/null 2>&1; [ -z "$BUANG_REF" ] || buang_ref_lokal "$BUANG_REF"' EXIT
# Pembatalan job (SIGINT/SIGTERM dari runner) tetap lewat trap EXIT di atas.
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# Login GHCR sementara: token dari stdin, hanya ke DOCKER_CONFIG temp di atas.
ghcr_login() {
  local token
  IFS= read -r token || true
  [ -n "$token" ] || die "token GHCR kosong (kirim lewat stdin)"
  printf '%s' "$token" | docker login ghcr.io -u urusin-ci --password-stdin >/dev/null || die "login GHCR gagal"
}

# Batas sumber daya untuk SEMUA kontainer yang dibuat runner (di luar cgroup unit systemd runner).
# Tanpa --blkio-weight: scheduler disk agent-vm "none" (bobot I/O tidak berlaku) dan Docker Desktop menolaknya.
LIMITS_DASAR=(--memory 4g --memory-swap 4g --pids-limit 2048 --ulimit core=0)
LIMITS_SISA=(--cpu-shares 256 "${LIMITS_DASAR[@]}")
LIMITS=(--cpus 1.5 "${LIMITS_SISA[@]}")
# `pw perf` (Lighthouse): rata-rata tetap 1,5 CPU, tetapi periode CFS 10 ms (bawaan 100 ms). Bila kuota habis,
# jeda throttle selalu < 10 ms, bukan puluhan ms yang menyela task main-thread dan menambah noise TBT.
# Bobot CPU bawaan (1024, sama dengan kontainer lain), bukan 256: dengan 256 kontainer perf hanya mendapat 1/4
# jatah saat host sibuk, task teramati memanjang lalu dikali multiplier, dan TBT melonjak (run 43032218573,
# 43042454102). Kuota 1,5 CPU tetap menjadi batas atas, jadi layanan lain tidak pernah kehilangan lebih dari itu.
LIMITS_PERF=(--cpu-period 10000 --cpu-quota 15000 --cpu-shares 256 "${LIMITS_DASAR[@]}")

# Platform build: arm64 selalu (agent-vm). amd64 hanya bila binfmt qemu-x86_64 SUDAH terdaftar di host
# (paket distro); skrip ini tidak pernah memasang binfmt (itu perubahan kernel host).
platforms() {
  local binfmt="${URUSIN_CI_BINFMT:-/proc/sys/fs/binfmt_misc/qemu-x86_64}"
  if [ -e "$binfmt" ] && grep -qx enabled "$binfmt" 2>/dev/null; then
    echo linux/amd64,linux/arm64
  else
    echo "ci-docker: PERINGATAN: binfmt qemu-x86_64 tidak ada; hanya linux/arm64" >&2
    echo linux/arm64
  fi
}

cmd_pw() {
  local job ws img script name sha
  job="$1"
  ws="$(valid_ws "$2")"
  sha="$3"
  valid_sha "$sha"
  img="$(pw_image "$ws")"
  case "$job" in
    e2e) script='pnpm install --frozen-lockfile --ignore-scripts && pnpm e2e' ;;
    perf)
      # scripts/lhci-jalan.mjs (collect + ulang run host-sibuk + assert); checkout lama tanpa skrip itu: autorun.
      script='pnpm install --frozen-lockfile --ignore-scripts && pnpm build && CHROME_PATH="$(ls -d /ms-playwright/chromium-*/chrome-linux*/chrome | head -n1)" PORT=4173 HOST=127.0.0.1 ORIGIN=http://127.0.0.1:4173 && export CHROME_PATH PORT HOST ORIGIN && if [ -f scripts/lhci-jalan.mjs ]; then node scripts/lhci-jalan.mjs; else pnpm exec lhci autorun; fi'
      ;;
    *) die "job Playwright tidak dikenal: '$job' (e2e|perf)" ;;
  esac
  disk_guard
  name="urusin-ci-pw-$job-$$"
  # Fase root (tetap, bukan kode repo), tanpa capability selain yang di bawah:
  #  - Playwright mengirim helper sandbox sebagai `chrome_sandbox` 0777 (bukan SUID); Chromium mencari
  #    `<dir exe>/chrome-sandbox`. Salinan root 4755 dibuat di sebelah Chromium DAN headless shell (e2e
  #    pendamping memakai headless shell), sama dengan image produksi (ADR 0029).
  #  - pnpm versi packageManager (Node 26 tidak membawa corepack).
  # Lalu turun ke uid/gid pemilik workspace tanpa capability efektif; kode repo berjalan di sana. turbo
  # menyaring env (PLAYWRIGHT_BROWSERS_PATH hilang), jadi ~/.cache/ms-playwright ditautkan ke /ms-playwright.
  # Sandbox Chromium tetap AKTIF (setuid, atau userns bila diizinkan); tidak pernah --no-sandbox untuk pendamping.
  # Versi pnpm dibaca DI HOST (root penuh). Fase root di kontainer berjalan dengan --cap-drop ALL, jadi tanpa
  # CAP_DAC_OVERRIDE ia tidak bisa membaca workspace milik urusin-ci (0750): "Permission denied".
  local uid gid pnpm_v
  pnpm_v="$(sed -nE 's/.*"packageManager": *"pnpm@([0-9]+[.][0-9]+[.][0-9]+).*/\1/p' "$ws/package.json" | head -n1)"
  [[ "$pnpm_v" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]] || die "packageManager pnpm@x.y.z tidak ada di package.json"
  uid="$(stat -c %u "$ws")"
  gid="$(stat -c %g "$ws")"
  local limits=("${LIMITS[@]}")
  [ "$job" = perf ] && limits=("${LIMITS_PERF[@]}")
  docker run --rm --init --name "$name" "${limits[@]}" \
    --cap-drop ALL --cap-add SYS_ADMIN --cap-add SYS_CHROOT --cap-add SETUID --cap-add SETGID \
    --security-opt "seccomp=$CI_ROOT/etc/pendamping-seccomp.json" \
    --tmpfs /tmp:size=1g,exec,mode=1777 \
    -v "$ws:/work" -w /work \
    -e CI=true -e HUSKY=0 -e GIT_SHA="$sha" -e HOME=/tmp/home \
    -e PW_SCRIPT="$script" -e PW_UID="$uid" -e PW_GID="$gid" -e PNPM_VERSION="$pnpm_v" \
    --entrypoint bash "$img" -c '
      set -e
      src="$(ls /ms-playwright/chromium-*/chrome-linux*/chrome_sandbox | head -n1)"
      [ -f "$src" ] || { echo "chrome_sandbox Playwright tidak ada" >&2; exit 1; }
      for d in /ms-playwright/chromium-*/chrome-linux* /ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux*; do
        [ -d "$d" ] || continue
        rm -f "$d/chrome-sandbox" && cp "$src" "$d/chrome-sandbox" && chmod 4755 "$d/chrome-sandbox"
        [ "$(stat -c %u:%a "$d/chrome-sandbox")" = 0:4755 ] || { echo "chrome-sandbox $d bukan 0:4755" >&2; exit 1; }
      done
      HOME=/root npm install -g --silent "pnpm@$PNPM_VERSION" >/dev/null  # cache npm root di /root, bukan HOME user
      exec setpriv --reuid="$PW_UID" --regid="$PW_GID" --clear-groups --inh-caps=-all \
        bash -c "mkdir -p \"\$HOME/.cache\" && ln -sfn /ms-playwright \"\$HOME/.cache/ms-playwright\" && $PW_SCRIPT"'
}

cmd_build() {
  local name sha ws meta digest
  name="$1"
  sha="$2"
  valid_name "$name"
  valid_sha "$sha"
  ws="$(valid_ws "$3")"
  disk_guard
  ghcr_login
  meta="$DOCKER_CONFIG/meta.json"
  # safe.directory: buildx membaca info git workspace (milik urusin-ci) untuk provenance vcs:revision;
  # deploy.sh mewajibkan SHA lengkap ada di provenance (REQUIRE_PROVENANCE=1).
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$ws" \
    docker buildx build --builder "$BUILDER" \
    --platform "$(platforms)" \
    --file "$ws/apps/$name/Dockerfile" \
    --build-arg "GIT_SHA=$sha" \
    --tag "$REPO_PREFIX-$name:$sha" \
    --push --sbom=true --provenance=mode=max \
    --metadata-file "$meta" \
    "$ws"
  digest="$(sed -nE 's/.*"containerimage\.digest": *"(sha256:[0-9a-f]{64})".*/\1/p' "$meta" | head -n1)"
  valid_digest "$digest"
  echo "DIGEST: $digest"
  # Builder docker-container + --push tidak memuat image ke daemon; bila ada ref lokal job ini, buang.
  buang_ref_lokal "$REPO_PREFIX-$name:$sha" "$REPO_PREFIX-$name@$digest"
  # Anggaran disk agent-vm: cache builder dipangkas ke batasnya setelah SETIAP build (hanya builder urusin-ci).
  builder_gc >&2
}

# Arsitektur native host (agent-vm = arm64). Smoke hanya native: node amd64 di bawah qemu-x86_64 bisa
# menggantung tanpa CPU (Release pernah tertahan > 22 menit). amd64 tetap dibangun dan di-push, lalu
# divalidasi lewat manifest index (lihat cek_manifest).
arch_native() {
  local m="${URUSIN_CI_ARCH:-$(uname -m)}"
  case "$m" in
    aarch64 | arm64) echo arm64 ;;
    x86_64 | amd64) echo amd64 ;;
    *) die "arsitektur host tidak didukung: '$m'" ;;
  esac
}

# Setiap platform yang dibangun (platforms) harus ada di manifest index yang di-push.
cek_manifest() {
  local ref raw p
  ref="$1"
  raw="$(timeout 120 docker buildx imagetools inspect --raw "$ref")" || die "manifest $ref tidak bisa dibaca"
  for p in $(platforms 2>/dev/null | tr ',' ' '); do
    grep -Eq "\"architecture\": *\"${p#linux/}\"" <<<"$raw" || die "manifest $ref tanpa $p"
    echo "manifest: $p ada"
  done
}

# docker run smoke dengan batas waktu. Kontainer diberi nama tetap supaya bisa dipaksa berhenti bila waktu
# habis (timeout hanya membunuh klien docker); hook cleanup juga membersihkan urusin-ci-smoke-*.
SMOKE_N=0
smoke_run() {
  local detik c rc
  detik="$1"
  shift
  SMOKE_N=$((SMOKE_N + 1))
  c="urusin-ci-smoke-$$-$SMOKE_N"
  SMOKE_C="$c"
  timeout "$detik" docker run --rm --name "$c" "$@" && { SMOKE_C=""; return 0; }
  rc=$?
  docker rm -f "$c" >/dev/null 2>&1 || true
  SMOKE_C=""
  [ "$rc" -ne 124 ] || echo "ci-docker: smoke melewati ${detik} s, kontainer $c dihentikan" >&2
  return "$rc"
}

# Hanya ref urusin-* milik job ini; tanpa -f, jadi image yang dipakai kontainer produksi tidak tersentuh.
buang_ref_lokal() {
  local ref
  for ref in "$@"; do docker image rm "$ref" >/dev/null 2>&1 || true; done
}

cmd_smoke() {
  local name digest ws ref arch
  name="$1"
  digest="$2"
  valid_name "$name"
  valid_digest "$digest"
  ws="$(valid_ws "$3")"
  disk_guard
  ghcr_login
  ref="$REPO_PREFIX-$name@$digest"
  arch="$(arch_native)"
  cek_manifest "$ref"
  echo "::group::$name linux/$arch (native)"
  # Hanya varian native yang ditarik: image store daemon tidak menyimpan layer arsitektur lain. Image smoke
  # tidak disimpan: trap EXIT membuangnya.
  BUANG_REF="$ref"
  timeout 900 docker pull -q --platform "linux/$arch" "$ref" >/dev/null
  case "$name" in
    web)
      smoke_run 120 "${LIMITS[@]}" --network none --platform "linux/$arch" --entrypoint node "$ref" \
        -e "const r=require('better-sqlite3')(':memory:').prepare('select 1 as x').get();if(r.x!==1)process.exit(1);console.log(process.arch,'better-sqlite3 ok')"
      ;;
    fixtures)
      smoke_run 120 "${LIMITS[@]}" --platform "linux/$arch" --entrypoint sh "$ref" -c \
        'node dist/server.js & sleep 5; node -e "fetch(\"http://127.0.0.1:4000/health\").then(r=>process.exit(r.ok?0:1),()=>process.exit(1))" && echo "fixtures ok"'
      ;;
    pendamping)
      # Satu-satunya biner SUID = chrome-sandbox 0:4755, getcap kosong (sama dengan release.yml).
      smoke_run 300 "${LIMITS[@]}" --platform "linux/$arch" --network none --entrypoint sh "$ref" -c \
        'f=$(find / -xdev -type f -perm /6000 2>/dev/null); echo "$f"; case "$f" in /ms-playwright/chromium-*/chrome-linux*/chrome-sandbox) ;; *) exit 1 ;; esac; [ "$(stat -c %u:%a "$f")" = 0:4755 ] && [ "$CHROME_DEVEL_SANDBOX" = "$f" ] && c=$(getcap -r / 2>/dev/null) && echo "getcap: [$c]" && [ -z "$c" ]'
      # Boot dengan pengerasan compose (seccomp terpasang di host, bukan dari workspace).
      smoke_run 300 --init "${LIMITS[@]}" --platform "linux/$arch" --network none --read-only \
        --tmpfs /tmp:size=768m --cap-drop ALL --cap-add SYS_ADMIN --cap-add SYS_CHROOT \
        --security-opt "seccomp=$CI_ROOT/etc/pendamping-seccomp.json" \
        -e PENDAMPING_INTERNAL_TOKEN="$(openssl rand -hex 32)" -e PENDAMPING_EDGE_URL=http://pendamping-edge:3129 \
        -e PENDAMPING_EDGE_TOKEN="$(openssl rand -hex 32)" -e URUSIN_PUBLIC_ORIGIN=https://smoke.test \
        --entrypoint sh "$ref" -c \
        'node dist/main.js & for i in $(seq 1 60); do node dist/sehat.js 4330 && echo "pendamping ok (sandbox + tanpa rute)" && exit 0; kill -0 $! 2>/dev/null || exit 1; sleep 2; done; exit 1'
      smoke_run 120 "${LIMITS[@]}" --platform "linux/$arch" --network none --entrypoint node "$ref" \
        -e "import('./dist/edge.js').then((m)=>{m.loadEdgeConfig({PENDAMPING_EDGE_TOKEN:'x'.repeat(40)});console.log('edge ok')})"
      ;;
    embedding)
      # Pengerasan compose (nobody, read-only, tanpa kapabilitas, tanpa jaringan) + uji semantik di dalam image.
      smoke_run 300 "${LIMITS[@]}" --platform "linux/$arch" --network none --read-only --tmpfs /tmp:size=16m \
        --user 65534:65534 --cap-drop ALL --security-opt no-new-privileges:true --entrypoint sh "$ref" -c \
        '/app/llama-server & for i in $(seq 1 120); do curl -fsS http://127.0.0.1:8080/health >/dev/null 2>&1 && break; kill -0 $! || exit 1; sleep 2; done; /usr/local/bin/embed-smoke'
      ;;
  esac
  echo "::endgroup::"
  if ! cmp -s "$ws/deploy/pendamping-seccomp.json" "$CI_ROOT/etc/pendamping-seccomp.json"; then
    echo "::warning::deploy/pendamping-seccomp.json di commit ini beda dari salinan terpasang di $CI_ROOT/etc; smoke memakai salinan terpasang"
  fi
}

# Tarik image rilis ke docker host dan BIARKAN di sana (tanpa BUANG_REF), supaya deploy.sh memakai image lokal
# tanpa kredensial GHCR. Hanya varian native. Label revision harus SHA lengkap dan provenance buildx harus
# memuatnya (cek yang sama dengan deploy.sh); provenance disalin ke $PROV_DIR/<hex digest>.json (0644, root).
cmd_simpan() {
  local name digest ref arch label prov tmp
  name="$1"
  digest="$2"
  valid_name "$name"
  valid_digest "$digest"
  valid_ws "$3" >/dev/null
  disk_guard
  ghcr_login
  ref="$REPO_PREFIX-$name@$digest"
  arch="$(arch_native)"
  cek_manifest "$ref"
  timeout 900 docker pull -q --platform "linux/$arch" "$ref" >/dev/null || die "pull $ref gagal"
  label="$(docker image inspect "$ref" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
  [[ "$label" =~ ^[0-9a-f]{40}$ ]] || die "label revision $ref bukan SHA lengkap: '$label'"
  prov="$(timeout 120 docker buildx imagetools inspect "$ref" --format '{{json .Provenance}}')" || die "provenance $ref tidak bisa dibaca"
  grep -qF -- "$label" <<<"$prov" || die "provenance $ref tidak memuat SHA $label"
  install -d -m 0755 "$PROV_DIR"
  tmp="$(mktemp "$PROV_DIR/.prov.XXXXXX")"
  printf '%s\n' "$prov" > "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$PROV_DIR/${digest#sha256:}.json"
  # Salinan lama (> 30 hari) dibuang; image-nya diatur image-retention.sh di sisi deploy.
  find "$PROV_DIR" -maxdepth 1 -name '*.json' -mtime +30 -delete 2>/dev/null || true
  echo "SIMPAN: $ref linux/$arch revision=$label"
}

cmd_sbom() {
  valid_name "$1"
  valid_digest "$2"
  ghcr_login
  docker buildx imagetools inspect "$REPO_PREFIX-$1@$2" --format '{{ json .SBOM }}'
}

cmd_alias() {
  local sha tag image digest tag_digest
  sha="$1"
  tag="$2"
  valid_sha "$sha"
  [[ "$tag" =~ ^(rc|v)[0-9A-Za-z._-]{1,64}$ ]] || die "tag rilis harus rc*/v*: '$tag'"
  ghcr_login
  for image in "$REPO_PREFIX-web" "$REPO_PREFIX-fixtures" "$REPO_PREFIX-pendamping" "$REPO_PREFIX-embedding"; do
    digest="$(docker buildx imagetools inspect "$image:$sha" --format '{{.Manifest.Digest}}' 2>/dev/null)" || digest=""
    valid_digest "$digest"
    docker buildx imagetools create -t "$image:$tag" "$image@$digest"
    tag_digest="$(docker buildx imagetools inspect "$image:$tag" --format '{{.Manifest.Digest}}')"
    [ "$tag_digest" = "$digest" ] || die "digest $image:$tag ($tag_digest) != :$sha ($digest)"
    echo "- \`$image:$tag\` = \`$image@$tag_digest\` (sama dengan \`:$sha\`)"
  done
}

cmd_builder_init() {
  mkdir -p "$BUILDX_CONFIG"
  if docker buildx inspect "$BUILDER" >/dev/null 2>&1; then
    echo "builder $BUILDER sudah ada"
  else
    # Cache dibatasi di buildkitd.toml (maxUsedSpace). Kontainer buildkit dibatasi CPU/memori.
    docker buildx create --name "$BUILDER" --driver docker-container \
      --driver-opt "memory=4g,memory-swap=4g,cpu-period=100000,cpu-quota=150000,cpu-shares=256" \
      --buildkitd-config "$CI_ROOT/etc/buildkitd.toml" >/dev/null
  fi
  docker buildx inspect --bootstrap "$BUILDER" | sed -n '1,8p'
}

# Satu-satunya pembersihan cache yang diizinkan: milik builder urusin-ci (bukan prune global).
builder_gc() { docker buildx prune --builder "$BUILDER" --force --max-used-space "$CACHE_MAX" | tail -n1; }

case "${1:-}" in
  pw) [ $# -eq 4 ] || die "pemakaian: pw <e2e|perf> <workspace> <sha40>"; cmd_pw "$2" "$3" "$4" ;;
  build) [ $# -eq 4 ] || die "pemakaian: build <nama> <sha40> <workspace>"; cmd_build "$2" "$3" "$4" ;;
  smoke) [ $# -eq 4 ] || die "pemakaian: smoke <nama> <digest> <workspace>"; cmd_smoke "$2" "$3" "$4" ;;
  simpan) [ $# -eq 4 ] || die "pemakaian: simpan <nama> <digest> <workspace>"; cmd_simpan "$2" "$3" "$4" ;;
  sbom) [ $# -eq 3 ] || die "pemakaian: sbom <nama> <digest>"; cmd_sbom "$2" "$3" ;;
  alias) [ $# -eq 3 ] || die "pemakaian: alias <sha40> <tag>"; cmd_alias "$2" "$3" ;;
  builder-init) cmd_builder_init ;;
  builder-gc) builder_gc ;;
  # Hook job-completed: kontainer sisa milik runner (urusin-ci-pw-*, urusin-ci-smoke-*) dan DOCKER_CONFIG temp
  # lama. Builder buildkit (buildx_buildkit_urusin-ci0) tidak cocok pola ini dan tidak disentuh.
  cleanup)
    docker ps -aq --filter 'name=^urusin-ci-pw-' --filter 'name=^urusin-ci-smoke-' | xargs -r docker rm -f >/dev/null
    find /tmp -maxdepth 1 -name 'urusin-ci-docker.*' -type d ! -path "$DOCKER_CONFIG" -mmin +1 -exec rm -rf {} + 2>/dev/null || true
    echo "ci-docker: cleanup selesai"
    ;;
  builder-rm) docker buildx rm "$BUILDER" ;;
  teardown)
    docker ps -aq --filter 'name=^urusin-ci-' | xargs -r docker rm -f >/dev/null
    docker buildx rm "$BUILDER" 2>/dev/null || true
    ;;
  *) die "subperintah: pw|build|smoke|simpan|sbom|alias|builder-init|builder-gc|builder-rm|cleanup|teardown" ;;
esac
