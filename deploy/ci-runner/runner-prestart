#!/usr/bin/env bash
# ExecStartPre (root, prefiks `+` di unit) sebelum runner persisten hidup (juga setiap restart):
#   1. Tolak bila disk >= 88% (unit dicoba lagi tiap RestartSec; runner tidak mengambil job).
#   2. Pastikan HOME runner (cache pnpm/npm) ada dan milik urusin-ci.
# Tidak ada token di sini: runner memakai kredensial runner miliknya sendiri (hasil config.sh sekali).
set -euo pipefail
CI_ROOT="${URUSIN_CI_ROOT:-/opt/urusin-ci}"
DISK_MAX="${URUSIN_CI_DISK_MAX:-88}"
die() { echo "runner-prestart: $*" >&2; exit 1; }

pct="$(df --output=pcent / | tail -n1 | tr -dc '0-9')"
[ "$pct" -lt "$DISK_MAX" ] || die "disk ${pct}% >= ${DISK_MAX}%: runner tidak dijalankan"
[ -f "$CI_ROOT/runner/.runner" ] || die "runner belum didaftarkan (jalankan install.sh dengan registration token)"
install -d -m 0750 -o urusin-ci -g urusin-ci "$CI_ROOT/runner/_home"
echo "runner-prestart: disk ${pct}%"
