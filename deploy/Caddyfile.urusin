# Snippet untuk di-import ke Caddyfile host (Caddy sistem yang sudah memegang 80/443):
#
#   import /opt/urusin/deploy/Caddyfile.urusin
#
# Caddy membaca {$DOMAIN} dari environment proses Caddy (lihat deploy/README.md). Satu-satunya
# Content-Security-Policy dikirim aplikasi (SvelteKit); jangan menambah CSP di sini.

(urusin_common) {
	# Kompresi hanya untuk tipe yang aman dikompres. Matcher bawaan Caddy menyertakan `text/*`
	# (https://caddyserver.com/docs/caddyfile/directives/encode) sehingga `text/event-stream` (SSE)
	# ikut terkompres dan tertahan di buffer encoder. Matcher respons Caddy tidak punya negasi
	# nilai, jadi daftarnya ditulis eksplisit: bawaan Caddy dikurangi `text/*`, ditambah tipe
	# teks yang memang dilayani aplikasi.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type text/xml*
			header Content-Type text/csv*
			header Content-Type application/atom+xml*
			header Content-Type application/font*
			header Content-Type application/geo+json*
			header Content-Type application/graphql+json*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/ld+json*
			header Content-Type application/manifest+json*
			header Content-Type application/rss+xml*
			header Content-Type application/vnd.api+json*
			header Content-Type application/wasm*
			header Content-Type application/x-javascript*
			header Content-Type application/xhtml+xml*
			header Content-Type application/xml*
			header Content-Type font/*
			header Content-Type image/svg+xml*
			header Content-Type image/x-icon*
		}
	}

	header {
		# TANPA includeSubDomains: DOMAIN dipakai bersama layanan lain di host, dan sub-domain
		# milik layanan itu belum tentu siap HTTPS-only. `verify.` sudah tercakup karena Caddy
		# mengirim header ini pada kedua host. Naikkan ke includeSubDomains hanya setelah semua
		# sub-domain dipastikan HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kamera dipakai untuk foto dokumen, mikrofon untuk suara.
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# Tujuan `report-to` pada CSP aplikasi (endpoint relatif terhadap origin).
		Reporting-Endpoints `csp-endpoint="/api/csp-report"`
		-Server
	}

	# Blue/green: dua instance web (4310 = blue, 4311 = green). `lb_policy first` memilih upstream
	# sehat pertama. `/api/ready` (bukan /api/health) hanya 200 pada warna yang DIPROMOSIKAN deploy.sh
	# (setelah smoke test lulus), jadi warna baru tidak menerima lalu lintas sebelum waktunya walau
	# port 4310 sudah hidup. PERHATIAN urutan upgrade pertama: lihat README "Upgrade ke /api/ready".
	# `health_uri` memeriksa aktif, dan
	# `lb_try_duration` mengulang permintaan yang gagal tersambung sehingga tidak ada respons 502
	# selama pergantian. flush_interval -1: teruskan SSE tanpa buffering.
	reverse_proxy 127.0.0.1:4310 127.0.0.1:4311 {
		lb_policy first
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /api/ready
		health_interval 2s
		health_timeout 2s
		health_status 200
		fail_duration 10s
		flush_interval -1
	}
}

# Aplikasi memilih rute /verify dari header Host mentah, jadi kedua host ke upstream yang sama.
{$DOMAIN}, verify.{$DOMAIN} {
	# Browser Pendamping (WebSocket layar). Nonaktif: butuh persetujuan port 127.0.0.1:4330 dan
	# `COMPOSE_PROFILES=pendamping` (lihat deploy/compose.prod.yml). HANYA /pendamping/ws/* yang diteruskan;
	# /internal/* pendamping tidak pernah diekspos. Origin + tiket sekali pakai diperiksa pendamping.
	#
	# handle /pendamping/ws/* {
	# 	uri strip_prefix /pendamping
	# 	reverse_proxy 127.0.0.1:4330
	# }
	import urusin_common
}

# Fixture publik (portal palsu untuk demo), profil `public`, 127.0.0.1:4320. Nonaktif secara bawaan:
# buka komentar setelah DNS fixtures.DOMAIN ada dan `COMPOSE_PROFILES=fixtures` + FIXTURES_IMAGE diset
# (lihat deploy/README.md). FIXTURES_PUBLIC_ORIGIN diisi compose menjadi https://fixtures.$DOMAIN.
#
# fixtures.{$DOMAIN} {
# 	encode zstd gzip
# 	header {
# 		Strict-Transport-Security "max-age=31536000"
# 		X-Content-Type-Options "nosniff"
# 		# Situs uji: jangan diindeks dan tandai jelas bukan situs pemerintah (nilai header ASCII).
# 		X-Robots-Tag "noindex, nofollow"
# 		X-Site-Notice "Situs uji - bukan situs pemerintah"
# 		-Server
# 	}
# 	reverse_proxy 127.0.0.1:4320
# }
