#!/usr/bin/env bash
# Docker palsu untuk tes ci-docker: catat argumen (satu baris per panggilan), tiru login/buildx/run.
{ printf "docker"; printf " [%s]" "$@"; echo; } >> "$SHIM_DIR/calls.log"
case "$1" in
  login) printf '%s' "$(cat)" > "$SHIM_DIR/login.stdin"; echo "$DOCKER_CONFIG" > "$SHIM_DIR/login.dir"; exit 0 ;;
  buildx)
    case "$2" in
      build)
        while [ $# -gt 0 ]; do [ "$1" = --metadata-file ] && { printf '{"containerimage.digest": "sha256:%064d"}\n' 7 > "$2"; }; shift; done
        exit 0 ;;
      inspect) exit "${SHIM_NO_BUILDER:-0}" ;;
      imagetools)
        if [ "$3" = inspect ] && [ "$4" = --raw ]; then
          # Index multi-arch: platform dari SHIM_PLATFORMS (bawaan arm64 + amd64) + manifest attestation.
          printf '{"manifests": ['
          for p in ${SHIM_PLATFORMS-linux/arm64 linux/amd64}; do printf '{"platform": {"architecture": "%s", "os": "linux"}}, ' "${p#linux/}"; done
          printf '{"platform": {"architecture": "unknown", "os": "unknown"}}]}\n'
        elif [ "$3" = inspect ] && [[ "$*" == *Provenance* ]]; then
          echo "{\"SLSA\":{\"vcs\":\"${SHIM_PROV_SHA-2175bb0c67fe37631a73ad92e23d600b705a018b}\"}}"
        elif [ "$3" = inspect ]; then
          printf 'sha256:%064d\n' 5
        fi
        exit 0 ;;
      *) exit 0 ;;
    esac ;;
  run) exit "${SHIM_RUN_RC:-0}" ;;
  pull) exit "${SHIM_PULL_RC:-0}" ;;
  image) [ "$2" = inspect ] && echo "${SHIM_LABEL-2175bb0c67fe37631a73ad92e23d600b705a018b}"; exit 0 ;;
  *) exit 0 ;;
esac
