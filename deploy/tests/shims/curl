#!/usr/bin/env bash
# curl palsu: /api/health lokal per warna; publik hanya /api/ready (mengikuti warna yang dipromosikan),
# /api/health publik dijawab 404 seperti snippet Caddy.
url="${*: -1}"
echo "curl $*" >> "$SHIM_DIR/calls.log"
body() { printf '{"ok":true,"status":"ok","gitSha":"%s","version":"0.0.0"%s}' "$(cat "$SHIM_DIR/running.$1")" "${SHIM_TURNS:+,\"runningTurns\":$SHIM_TURNS}"; }
case "$url" in
  https://zd.test/*) if [ -n "${SHIM_ZD_FAIL:-}" ]; then echo 503; else echo 200; fi; exit 0 ;;
  http://127.0.0.1:431[01]/api/ready)
    port="${url#http://127.0.0.1:}"; port="${port%%/*}"; c=blue; [ "$port" = 4311 ] && c=green
    if [ -n "${SHIM_NO_READY:-}" ]; then echo 404; exit 0; fi
    if [ -f "$SHIM_DIR/running.$c" ] && [ "$(cat "$SHIM_DIR/promoted" 2>/dev/null)" = "$c" ]; then echo 200; else echo 503; fi
    exit 0 ;;
  http://127.0.0.1:431[01]/api/kemampuan)
    # SHIM_KEMAMPUAN: badan JSON (default mode demo); SHIM_KEMAMPUAN_GAGAL=1 = kontainer tak menjawab.
    [ -z "${SHIM_KEMAMPUAN_GAGAL:-}" ] || exit 22
    demo='{"llm":"demo","kapabilitas":{"ai":"normal"}}'
    printf '%s' "${SHIM_KEMAMPUAN:-$demo}"; exit 0 ;;
  http://127.0.0.1:4310/api/health) [ -f "$SHIM_DIR/running.blue" ] && { body blue; exit 0; }; exit 7 ;;
  http://127.0.0.1:4311/api/health) [ -f "$SHIM_DIR/running.green" ] && { body green; exit 0; }; exit 7 ;;
  http://127.0.0.1:4330/health) [ -n "${SHIM_PENDAMPING_HEALTH:-}" ] || exit 7; echo "$SHIM_PENDAMPING_HEALTH"; exit 0 ;;
  https://verify.*) [ -z "${SHIM_PUBLIC_FAIL:-}" ] || exit 60; echo 200; exit 0 ;;
  https://*/api/health) echo "${SHIM_PUBLIC_HEALTH_CODE:-404}"; exit 0 ;; # Caddy: respond /api/health 404
  https://*/api/ready)
    [ -z "${SHIM_PUBLIC_FAIL:-}" ] || exit 60
    # Caddy (`health_uri /api/ready`): ikut warna yang dipromosikan; tanpa penanda, warna pertama yang hidup.
    p="$(cat "$SHIM_DIR/promoted" 2>/dev/null)"
    ready() { printf '{"ready":true,"color":"%s"}' "$1"; }
    if [ -n "$p" ]; then [ -f "$SHIM_DIR/running.$p" ] && { ready "$p"; exit 0; }; exit 22; fi
    for c in blue green; do [ -f "$SHIM_DIR/running.$c" ] && { ready "$c"; exit 0; }; done
    exit 22 ;;
esac
exit 1
