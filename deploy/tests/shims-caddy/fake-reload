#!/usr/bin/env bash
# Reload palsu, dipanggil override reload_caddy di tes dan dicatat sebagai "systemctl reload caddy".
# Reload pertama dapat "merusak" satu situs (SHIM_BREAK_SITE -> 502); reload berikutnya (rollback)
# memulihkan kode status awal dari $SHIM_DIR/orig.<situs>.
echo "systemctl $*" >> "$SHIM_DIR/calls.log"
[ -z "${SHIM_RELOAD_FAIL:-}" ] || exit 1
n=$(($(cat "$SHIM_DIR/reloads" 2>/dev/null || echo 0) + 1))
echo "$n" > "$SHIM_DIR/reloads"
if [ "$n" = 1 ] && [ -n "${SHIM_BREAK_SITE:-}" ]; then echo 502 > "$SHIM_DIR/code.$SHIM_BREAK_SITE"; fi
if [ "$n" -ge 2 ]; then
  for f in "$SHIM_DIR"/orig.*; do [ -e "$f" ] && cp "$f" "$SHIM_DIR/code.${f##*/orig.}"; done
fi
exit 0
