    "playwright-core": "1.65.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@urusin/fixtures": "workspace:*",
    "vitest": "5.1.0"
  }
